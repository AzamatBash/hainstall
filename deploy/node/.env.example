# Copy to .env and fill in values. Never commit .env.

# Shared bearer token for the node agent API
HAPANEL_TOKEN=change-me-to-a-long-random-secret

# Optional: public hostname this node terminates (docs / ACME hints)
HAPANEL_DOMAIN=node1.example.com

# Host docker group GID (so agent can use docker.sock). On Linux:
#   getent group docker | cut -d: -f3
DOCKER_GID=999
