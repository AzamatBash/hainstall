# Panel admin password (required in production).
# Prefer auto-install (generates a strong password and prints it once):
#   bash scripts/install-panel.sh
# Or set manually:
PANEL_PASSWORD=changeme

# JWT signing secret for session cookies / Bearer tokens
# Install script sets: openssl rand -hex 32
PANEL_JWT_SECRET=change-me-to-a-long-random-secret

# Host port mapped to container :3080
PANEL_PORT=3080

# Default image: azamatbash/hapanel:0.1.0 (see docker-compose.yml).
# Install from Hub (self-contained, no full clone needed for runtime):
#   bash scripts/install-panel.sh
# Manual: docker compose pull && docker compose up -d
# Local rebuild:    docker compose up -d --build
#
# Login brute-force: max 5 failed attempts per IP → 15 min lockout (429).

# Skip TLS certificate verification when panel→node uses self-signed certs (MVP).
# Set to false once nodes have valid certificates.
HAPANEL_INSECURE_SKIP_VERIFY=true

# uTLS ClientHello fingerprint for panel→node (randomized|chrome|firefox|golang).
# Browser presets often fail against HAProxy; randomized is the safe default.
HAPANEL_UTLS_HELLO=randomized
